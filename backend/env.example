# Server
PORT=8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_local_db_password
DB_DATABASE=gastoodb

# Auth (generate your own random secrets, e.g. via `openssl rand -hex 64`)
ACCESS_KEY_SECRET=your_access_token_secret
REFRESH_KEY_SECRET=your_refresh_token_secret

# GenAI (Smart Insights feature)
GEMINI_API_KEY=your_gemini_api_key

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your_email@example.com

# Cloudinary (image uploads, e.g. profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
